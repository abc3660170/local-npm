{
  "name": "fee-local-npm",
  "version": "3.0.1",
  "description": "Local and offline-first npm mirror",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "coverage": "tap test/**.js --coverage --coverage-report=html",
    "start": "node ./bin/index.js",
    "dev": "nodemon --watch \"lib/**/*.ts\" --exec node --loader ts-node/esm \"./src/dev.ts\"",
    "build": "rollup -c rollup.config.js && tsup lib/index.ts --format esm --dts --outDir dist"
  },
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">= 10"
  },
  "author": {
    "name": "tchen",
    "email": "3413218@gmail.com"
  },
  "bin": {
    "local-npm": "bin/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abc3660170/local-npm.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/http-proxy": "^11.0.0",
    "@fastify/static": "^8.0.3",
    "axios": "^1.7.9",
    "classic-level": "^2.0.0",
    "commander": "^12.1.0",
    "corser": "^2.0.0",
    "fastify": "^5.1.0",
    "pino-pretty": "^13.0.0",
    "semver": "^7.6.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@npm/types": "^2.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^20.17.9",
    "@types/semver": "^7.5.8",
    "nodemon": "^3.1.7",
    "rollup": "^4.34.6",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.2"
  }
}
