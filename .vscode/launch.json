{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Debug with ts-node",
        "runtimeArgs": [
          "--loader=ts-node/esm"
        ],
        "program": "${workspaceFolder}/bin/index.ts",
        "cwd": "${workspaceFolder}",
        "sourceMaps": true,
        "resolveSourceMapLocations": [
          "${workspaceFolder}/**",
          "!**/node_modules/**"
        ],
        "outFiles": [
          "${workspaceFolder}/**/*.js"
        ],
        "env": {
          "NODE_OPTIONS": "--experimental-specifier-resolution=node"
        }
      }
    ]
  }
  